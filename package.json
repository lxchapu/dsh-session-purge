{
  "name": "@lxchapu/dsh-session-purge",
  "version": "0.1.1",
  "description": "彻底删除 DSH 会话：单条删除 + 仅看已归档时一键全部删除（带二次确认）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "purge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxchapu/dsh-session-purge.git"
  },
  "homepage": "https://github.com/lxchapu/dsh-session-purge#readme",
  "bugs": {
    "url": "https://github.com/lxchapu/dsh-session-purge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "manifestVersion": 1
  },
  "license": "MIT"
}
